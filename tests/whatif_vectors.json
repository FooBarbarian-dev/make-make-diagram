          }
        }
      }
    },
    {
      "name": "features: no docs changed — docs_check falls to the delayed rule",
      "fixture": "whatif_features",
      "config": {"scenario": "push_branch", "branch": "main", "changedFiles": []},
      "expect": {
        "candidates": {"branch": {"jobs": {"docs_check": "delayed"}}}
