{
  "_comment": "Hand-written expectations taken from the GitLab docs (job_rules, workflow, predefined_variables). The Python side compiles `src` to an AST; the shipped whatif.js evaluates it. 'unknown' is the tri-state third value.",
  "expr": [
    {"name": "eq matches", "src": "$CI_COMMIT_BRANCH == \"main\"",
     "env": {"CI_COMMIT_BRANCH": "main"}, "expect": true},
    {"name": "eq against unset var is false", "src": "$CI_COMMIT_BRANCH == \"main\"",
     "env": {}, "expect": false},
    {"name": "unset == null is true", "src": "$V == null", "env": {}, "expect": true},
    {"name": "empty string == null is false", "src": "$V == null",
     "env": {"V": ""}, "expect": false},
    {"name": "empty == empty-literal", "src": "$V == \"\"", "env": {"V": ""}, "expect": true},
    {"name": "unset == empty-literal is false", "src": "$V == \"\"", "env": {}, "expect": false},
    {"name": "bare unset var is falsy", "src": "$V", "env": {}, "expect": false},
    {"name": "bare empty var is falsy", "src": "$V", "env": {"V": ""}, "expect": false},
    {"name": "the string false is truthy", "src": "$V", "env": {"V": "false"}, "expect": true},
    {"name": "the string 0 is truthy", "src": "$V", "env": {"V": "0"}, "expect": true},
    {"name": "not of the string false is false", "src": "!$V",
     "env": {"V": "false"}, "expect": false},
    {"name": "not of unset is true", "src": "!$V", "env": {}, "expect": true},
    {"name": "and binds before or (left)", "src": "$A && $B || $C",
     "env": {"A": "x", "C": "y"}, "expect": true},
    {"name": "and binds before or (right)", "src": "$A || $B && $C",
     "env": {"B": "x"}, "expect": false},
    {"name": "parens override precedence", "src": "($A || $B) && $C",
     "env": {"B": "x"}, "expect": false},
    {"name": "regex match", "src": "$REF =~ /^feature-.*/",
     "env": {"REF": "feature-login"}, "expect": true},
    {"name": "regex is case-sensitive by default", "src": "$REF =~ /^feature-.*/",
     "env": {"REF": "FEATURE-LOGIN"}, "expect": false},
    {"name": "i flag makes it case-insensitive", "src": "$REF =~ /^feature-.*/i",
     "env": {"REF": "FEATURE-LOGIN"}, "expect": true},
    {"name": "regex against unset var is false", "src": "$REF =~ /x/",
     "env": {}, "expect": false},
    {"name": "negative match on unset var is true", "src": "$REF !~ /x/",
     "env": {}, "expect": true},
    {"name": "regex stored in a variable", "src": "$T =~ $P",
     "env": {"T": "abcde", "P": "/^ab.*/"}, "expect": true},
    {"name": "unset left matches an empty-string-matching regex", "src": "$U =~ /.*/",
     "env": {}, "expect": true},
    {"name": "negative of the empty-string match", "src": "$U !~ /.*/",
     "env": {}, "expect": false},
    {"name": "unset pattern variable is a definite no-match", "src": "\"x\" =~ $PAT",
     "env": {}, "expect": false},
    {"name": "unset pattern variable with !~ is true", "src": "\"x\" !~ $PAT",
     "env": {}, "expect": true},
    {"name": "chained comparison: boolean never equals a string",
     "src": "$A == \"a\" == \"b\"", "env": {"A": "a"}, "expect": false},
    {"name": "chained comparison with != flips it",
     "src": "$A == \"a\" != \"b\"", "env": {"A": "a"}, "expect": true},
    {"name": "invalid unquoted boolean evaluates unknown", "src": "$X == true",
     "env": {"X": "true"}, "expect": "unknown"},
    {"name": "unsimulated predefined is runtime-unknown when controlled info is present",
     "src": "$CI_KUBERNETES_ACTIVE", "env": {},
     "controlled": {"names": [], "prefixes": []}, "expect": "unknown"},
    {"name": "deliberately-unset predefined stays definite false",
     "src": "$CI_COMMIT_TAG", "env": {},
     "controlled": {"names": ["CI_COMMIT_TAG"], "prefixes": []}, "expect": false},
    {"name": "documented substring fallback: 23 in 1234", "src": "$A =~ $B",
     "env": {"A": "23", "B": "1234"}, "expect": true},
    {"name": "var to var equality", "src": "$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH",
     "env": {"CI_COMMIT_BRANCH": "main", "CI_DEFAULT_BRANCH": "main"}, "expect": true},
    {"name": "unparseable expression is unknown", "src": "CI_COMMIT_BRANCH === \"oops\"",
     "env": {}, "expect": "unknown"},
    {"name": "unknown and false is false (hand-written AST)",
     "ast": {"op": "and", "args": [{"op": "opaque", "src": "?"},
                                   {"op": "truthy", "term": {"t": "var", "name": "B"}}]},
     "env": {}, "expect": false},
    {"name": "unknown and true is unknown (hand-written AST)",
     "ast": {"op": "and", "args": [{"op": "opaque", "src": "?"},
                                   {"op": "truthy", "term": {"t": "var", "name": "B"}}]},
     "env": {"B": "x"}, "expect": "unknown"},
    {"name": "unknown or true is true (hand-written AST)",
     "ast": {"op": "or", "args": [{"op": "opaque", "src": "?"},
                                  {"op": "truthy", "term": {"t": "var", "name": "B"}}]},
     "env": {"B": "x"}, "expect": true},
    {"name": "not unknown is unknown (hand-written AST)",
     "ast": {"op": "not", "arg": {"op": "opaque", "src": "?"}},
     "env": {}, "expect": "unknown"}
  ],
  "scenarios": [
