    },
    {
      "name": "features: unknown changed files — docs_check is conditional",
      "fixture": "whatif_features",
      "config": {"scenario": "push_branch", "branch": "main", "changedFiles": null},
      "expect": {
        "candidates": {"branch": {"jobs": {"docs_check": "conditional"}}}
