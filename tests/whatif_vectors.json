        },
        "duplicates": []
      }
    },
    {
      "name": "dedup: no MR open — branch pipeline allowed by rule 3",
      "fixture": "whatif_dedup",
      "config": {"scenario": "push_branch", "branch": "feature/widget"},
      "expect": {
        "candidates": {
          "branch": {"created": true,
                     "jobs": {"build_all": "runs", "lint_everything": "runs"}}
        },
        "duplicates": []
      }
    },
    {
      "name": "dedup: tag pipeline matches no workflow rule — not created",
      "fixture": "whatif_dedup",
      "config": {"scenario": "push_tag", "tag": "v1.0.0"},
      "expect": {
        "candidates": {"tag": {"created": false}},
        "duplicates": []
      }
    },
    {
      "name": "features: push to main with docs change",
      "fixture": "whatif_features",
      "config": {"scenario": "push_branch", "branch": "main",
                 "changedFiles": ["docs/guide.md"]},
      "expect": {
        "candidates": {
          "branch": {
            "created": true,
            "jobs": {"build_meta": "runs", "docker_build": "runs",
                     "docs_check": "runs", "legacy_deploy": "not-added",
                     "weird_rules": "conditional", "integration": "runs",
                     "package": "runs", "trigger_child": "runs"},
            "notesContain": ["dotenv report"],
            "children": {
              "ci/child.yml": {
                "jobs": {"ci/child.yml::child_build": "runs",
