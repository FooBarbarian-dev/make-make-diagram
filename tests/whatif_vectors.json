    },
    {
      "name": "features: DEPLOY_ENV=production unlocks the legacy job",
      "fixture": "whatif_features",
      "config": {"scenario": "push_branch", "branch": "main", "changedFiles": [],
                 "overrides": {"DEPLOY_ENV": "production"}},
      "expect": {
        "candidates": {"branch": {"jobs": {"legacy_deploy": "runs"}}}
      }
    },
    {
      "name": "features: tag pipeline blocked by workflow when:never",
      "fixture": "whatif_features",
      "config": {"scenario": "push_tag", "tag": "v1.0.0"},
      "expect": {
        "candidates": {"tag": {"created": false}}
